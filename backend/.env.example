# Base de datos: True = SQLite (desarrollo sin PostgreSQL), False = PostgreSQL
USE_SQLITE=True

# PostgreSQL (solo si USE_SQLITE=False)
DB_NAME="Sistema Jfactur"
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5434

# Django (SECRET_KEY: generar uno distinto en producción)
SECRET_KEY=
DEBUG=True

# Opcional: consulta nombre por DNI (RENIEC o proveedor). URL que recibe ?dni= y devuelve nombres/apellidos.
# DNI_LOOKUP_API_URL=

